# LLM CLIs use their own login/credential stores; no LLM secret is configured here.
# Optional external publishing provider. Never commit real values.
GITHUB_TOKEN=

# Default config path
AUTOPATCH_CONFIG=config/harness.yaml

# Local API should remain bound to loopback unless separately protected.
AUTOPATCH_API_HOST=127.0.0.1
AUTOPATCH_API_PORT=8000
