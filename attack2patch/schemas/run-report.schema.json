          "title": "Rule Id"
        },
        "scanner": {
          "title": "Scanner",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "sink": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sink"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
